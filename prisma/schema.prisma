generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ========== USUARIO ==========
model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  role      String   @default("user") // "superadmin" | "admin" | "user"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relaciones
  categories        Category[]
  incomes           Income[]
  expenses          Expense[]
  creditCards       CreditCard[]
  savingsGoals      SavingsGoal[]
  debts             Debt[]
  budgetProjections BudgetProjection[]

  @@index([role])
}

// ========== CATEGORÍAS ==========
model Category {
  id     Int     @id @default(autoincrement())
  name   String
  type   String // "income" | "expense"
  icon   String? // Icono para UI
  color  String? // Color hex para UI
  userId Int
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  incomes  Income[]
  expenses Expense[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, type])
}

// ========== INGRESOS ==========
model Income {
  id          Int      @id @default(autoincrement())
  amount      Decimal  @db.Decimal(12, 2)
  description String
  date        DateTime @default(now())
  isRecurring Boolean  @default(false) // Si es fijo/recurrente
  frequency   String? // "monthly" | "biweekly" | "weekly" | "annual" | null (para extra)
  categoryId  Int
  userId      Int
  notes       String?

  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, date])
  @@index([userId, isRecurring])
}

// ========== GASTOS ==========
model Expense {
  id            Int      @id @default(autoincrement())
  amount        Decimal  @db.Decimal(12, 2)
  description   String
  date          DateTime @default(now())
  isRecurring   Boolean  @default(false) // Si es fijo/recurrente
  frequency     String? // "monthly" | "biweekly" | "weekly" | "annual" | null (para variado)
  categoryId    Int
  userId        Int
  paymentMethod String   @default("cash") // "cash" | "debit" | "credit"
  creditCardId  Int? // Opcional: si se pagó con tarjeta de crédito
  isPaidOff         Boolean  @default(false) // Para gastos con tarjeta: marca si el estado de cuenta ya fue pagado
  installments      Int? // Número de cuotas (solo para tarjeta de crédito, null = pago único)
  installmentAmount Decimal? @db.Decimal(12, 2) // Cuota mensual real calculada (capital + interés / n)
  totalWithInterest Decimal? @db.Decimal(12, 2) // Total a pagar incluyendo intereses
  notes             String?

  category   Category    @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  creditCard CreditCard? @relation(fields: [creditCardId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, date])
  @@index([userId, isRecurring])
  @@index([creditCardId])
  @@index([userId, paymentMethod])
}

// ========== TARJETAS DE CRÉDITO ==========
model CreditCard {
  id              Int     @id @default(autoincrement())
  name            String // Ej: "Visa Gold", "MasterCard Platinum"
  bank            String // Banco emisor
  lastDigits      String // Últimos 4 dígitos
  creditLimit     Decimal @db.Decimal(12, 2) // Límite de crédito
  billingDay      Int // Día de corte (1-31)
  paymentDay      Int // Día de pago (1-31)
  interestRate    Float? // TEA - Tasa Efectiva Anual (fallback para cálculo de cuotas)
  installmentFees Json? // {"2": 15.806, "3": 19.156, ...} - % interés total sobre capital por n cuotas
  carriedBalance  Decimal @default(0) @db.Decimal(12, 2) // Saldo que no proviene de Expense (cuotas en curso, deuda previa a usar la app); se actualiza a mano con cada estado de cuenta
  isActive        Boolean @default(true)
  userId          Int

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expenses Expense[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, isActive])
}

// ========== METAS DE AHORRO ==========
model SavingsGoal {
  id            Int       @id @default(autoincrement())
  name          String // Ej: "Viaje a Europa", "Fondo emergencia"
  targetAmount  Decimal   @db.Decimal(12, 2) // Meta a alcanzar
  currentAmount Decimal   @default(0) @db.Decimal(12, 2) // Monto actual ahorrado
  deadline      DateTime? // Fecha objetivo (opcional)
  priority      Int       @default(1) // 1=alta, 2=media, 3=baja
  description   String?
  isCompleted   Boolean   @default(false)
  userId        Int

  user          User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  contributions SavingsContribution[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, isCompleted])
}

// ========== CONTRIBUCIONES A AHORROS ==========
model SavingsContribution {
  id            Int      @id @default(autoincrement())
  amount        Decimal  @db.Decimal(12, 2)
  date          DateTime @default(now())
  notes         String?
  savingsGoalId Int

  savingsGoal SavingsGoal @relation(fields: [savingsGoalId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([savingsGoalId, date])
}

// ========== DEUDAS ==========
model Debt {
  id                Int       @id @default(autoincrement())
  name              String // Ej: "Préstamo Personal", "Crédito Auto"
  creditor          String // A quién se debe
  totalAmount       Decimal   @db.Decimal(12, 2) // Monto total original
  remainingAmount   Decimal   @db.Decimal(12, 2) // Monto pendiente
  interestRate      Float // Tasa de interés anual
  monthlyPayment    Decimal   @db.Decimal(12, 2) // Cuota mensual
  totalInstallments Int?      @default(12) // Número total de cuotas del préstamo
  paymentDayOfMonth Int       @default(15) // Día del mes en que vence cada cuota (1-31)
  startDate         DateTime
  endDate           DateTime? // Fecha estimada de finalización
  isPaid            Boolean   @default(false)
  userId            Int

  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments     DebtPayment[]
  installments DebtInstallment[] // Cuotas programadas

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, isPaid])
}

// ========== CUOTAS PROGRAMADAS DE DEUDAS ==========
model DebtInstallment {
  id                Int      @id @default(autoincrement())
  installmentNumber Int // Número de cuota (1, 2, 3...)
  dueDate           DateTime // Fecha de vencimiento de esta cuota
  amount            Decimal  @db.Decimal(12, 2) // Monto de la cuota
  principal         Decimal  @db.Decimal(12, 2) // Capital programado
  interest          Decimal  @db.Decimal(12, 2) // Interés programado
  insurance         Decimal  @default(0) @db.Decimal(12, 2) // Seguro programado
  status            String   @default("pending") // "pending" | "paid" | "overdue" | "advanced"
  debtId            Int
  debtPaymentId     Int? // Vinculación con el pago realizado (si ya se pagó)

  debt        Debt         @relation(fields: [debtId], references: [id], onDelete: Cascade)
  debtPayment DebtPayment? @relation(fields: [debtPaymentId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([debtId, installmentNumber]) // Asegurar que no haya cuotas duplicadas
  @@index([debtId, status])
  @@index([dueDate, status])
}

// ========== PAGOS DE DEUDAS ==========
model DebtPayment {
  id            Int      @id @default(autoincrement())
  amount        Decimal  @db.Decimal(12, 2)
  principal     Decimal  @db.Decimal(12, 2) // Monto aplicado a capital
  interest      Decimal  @db.Decimal(12, 2) // Monto de interés
  insurance     Decimal  @default(0) @db.Decimal(12, 2) // Seguro de desgravamen
  date          DateTime @default(now())
  paymentNumber Int // Número de cuota
  notes         String?
  debtId        Int

  debt         Debt              @relation(fields: [debtId], references: [id], onDelete: Cascade)
  installments DebtInstallment[] // Cuotas que cubre este pago (puede ser más de una si se adelantaron)

  createdAt DateTime @default(now())

  @@index([debtId, date])
}

// ========== PROYECCIONES DE PRESUPUESTO ==========
model BudgetProjection {
  id          Int      @id @default(autoincrement())
  name        String // Ej: "Viaje a Cancún", "Compra de laptop"
  totalBudget Decimal  @db.Decimal(12, 2) // Presupuesto total necesario
  startDate   DateTime
  endDate     DateTime
  description String?

  // Proyecciones
  expectedIncome  Decimal @db.Decimal(12, 2) // Ingresos proyectados en el período
  fixedExpenses   Decimal @db.Decimal(12, 2) // Gastos fijos proyectados
  debtPayments    Decimal @db.Decimal(12, 2) // Pagos de deudas proyectados
  availableAmount Decimal @db.Decimal(12, 2) // Monto disponible después de fijos
  debitUsage      Decimal @db.Decimal(12, 2) // Sugerencia de uso en débito
  creditUsage     Decimal @db.Decimal(12, 2) // Sugerencia de uso en crédito
  savingsImpact   Decimal @db.Decimal(12, 2) // Impacto en ahorros

  isCompleted Boolean @default(false)
  userId      Int

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, startDate])
}
